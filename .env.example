# ===== Source : Supabase (PostgreSQL) =====
# Supabase impose le SSL : SUPABASE_SSLMODE doit rester sur "require".
# Connexion directe (Database > Connection string > URI dans Supabase Studio) :
#   host = db.<project_ref>.supabase.co
#   user = postgres
# ATTENTION : l'hote direct `db.*.supabase.co` ne resout **qu'en IPv6**. Sur un
# reseau IPv4-only, basculer sur le Connection Pooler (Session mode, port 5432) :
#   host = aws-<n>-<region>.pooler.supabase.com  (attention au cluster aws-0 vs aws-1 !)
#   user = postgres.<project_ref>
SUPABASE_HOST=db.<project_ref>.supabase.co
SUPABASE_PORT=5432
SUPABASE_USER=postgres
SUPABASE_PASSWORD=
SUPABASE_DB=postgres
SUPABASE_SSLMODE=require

# ===== Pipeline temps réel (LISTEN/NOTIFY -> BigQuery) =====
# Aucune clé API supplémentaire : le streaming réutilise la connexion PostgreSQL
# ci-dessus (canal `stock_events`, cf. ingestion/sql/stock_events_trigger.sql).
# Seuil d'alerte : une ligne stocks dont quantity <= seuil déclenche une alerte
# (la table source ne porte pas de point de réapprovisionnement).
STOCK_ALERT_THRESHOLD=5

# ===== Destination : Google BigQuery =====
GCP_PROJECT_ID=
# Dataset RAW cible de l'ingestion dlt (copie brute des tables Supabase).
GCP_DATASET_RAW=local_bike_raw
# Localisation du dataset BigQuery (doit matcher celle créée dans la console GCP)
GCP_LOCATION=EU

# Chemin vers la clé service account.
# Créer le dossier `secrets/` (ignoré par git) et y déposer le JSON de la clé :
#   mkdir -p secrets && mv ~/Downloads/<cle>.json secrets/gcp-sa.json
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json

# ===== Supervision (Prometheus / Grafana) =====
# Port d'exposition des métriques du flux temps réel, scrapé par Prometheus.
# Mettre 0 pour désactiver complètement l'endpoint /metrics.
STREAM_METRICS_PORT=9101

# Identifiants de l'UI Grafana (http://127.0.0.1:3001). À changer.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Canal de notification des alertes. Si SLACK_WEBHOOK_URL est renseigné, les alertes
# partent sur Slack ; sinon elles basculent sur ALERT_EMAIL. Dans les deux cas elles
# restent visibles dans Grafana (Alerting > Alert rules).
# Webhook : Slack > Apps > Incoming Webhooks.
SLACK_WEBHOOK_URL=
ALERT_EMAIL=data-alerts@localhost
