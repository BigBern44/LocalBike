# ===== Source : Supabase (PostgreSQL) =====
# Supabase impose le SSL : SUPABASE_SSLMODE doit rester sur "require".
# Connexion via le Connection Pooler (Session mode, port 5432) :
#   host = aws-<n>-<region>.pooler.supabase.com  (attention au cluster aws-0 vs aws-1 !)
#   user = postgres.<project_ref>
SUPABASE_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_USER=postgres.<project_ref>
SUPABASE_PASSWORD=
SUPABASE_DB=postgres
SUPABASE_SSLMODE=require

# ===== Destination : Google BigQuery =====
GCP_PROJECT_ID=
# Dataset RAW cible de l'ingestion dlt (copie brute des tables Supabase).
GCP_DATASET_RAW=local_bike_raw
# Localisation du dataset BigQuery (doit matcher celle créée dans la console GCP)
GCP_LOCATION=EU

# Chemin vers la clé service account.
# Créer le dossier `secrets/` (ignoré par git) et y déposer le JSON de la clé :
#   mkdir -p secrets && mv ~/Downloads/<cle>.json secrets/gcp-sa.json
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
